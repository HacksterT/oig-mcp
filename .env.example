# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On IBM Code Engine you usually leave this as stdio: app.py automatically
# switches to HTTP when the platform injects PORT.
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer token callers must present to /mcp. Required over HTTP, unused over
# stdio, at least 32 characters. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional tokens for other clients, as name:token,name:token, so one can be removed
# without affecting the rest. Manage them with deploy/mcp_clients.py.
MCP_CLIENT_TOKENS=

# ─── OIG data API (served by the oig-data-source repository) ─────────────────
# The one outbound origin this server calls. Local default is the oig-data-source container.
# Must be https unless it points at localhost.
# A hosted API also needs the Access token below.
OIG_DATA_API_BASE_URL=http://127.0.0.1:8787/v1/

# Cloudflare Access service token for the hosted data API. Leave empty for a
# local API. Never commit the filled-in .env.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# The data API's own key (its OIG_API_KEY), checked behind Access. Leave empty if
# the API doesn't require one. At least 32 characters.
OIG_DATA_API_KEY=

# Responses flag data older than this many days as stale.
STALE_AFTER_DAYS=30

# ─── Evaluation only (eval/README.md). The server does not read these ─────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
