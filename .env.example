# Copy to .env for local use, and never commit the filled-in copy.
#
# On IBM Code Engine there is no .env. The required values below go in a Code
# Engine secret (deploy/README.md), and the platform sets PORT, which switches
# the server to HTTP on its own. Everything marked optional can be left out.

# ─── OIG data API (required) ──────────────────────────────────────────────────
# The one outbound origin this server calls. Must be https unless it is local.
# The default is a local oig-data-source container.
OIG_DATA_API_BASE_URL=http://127.0.0.1:8787/v1/

# Cloudflare Access service token for the hosted API. Leave empty for a local API.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# The data API's own key (its OIG_API_KEY), checked behind Access. At least 32
# characters. Leave empty if the API does not require one.
OIG_DATA_API_KEY=

# ─── Callers (required for HTTP, unused over stdio) ───────────────────────────
# Bearer token callers send to /mcp. At least 32 characters: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: more tokens as name:token,name:token, so one client can be removed
# alone. Manage them with deploy/mcp_clients.py rather than by hand.
# MCP_CLIENT_TOKENS=

# ─── Optional, shown with their defaults ──────────────────────────────────────
# stdio for local clients, or streamable-http for local HTTP. Anything else stops
# startup. A platform-set PORT overrides this.
# MCP_TRANSPORT=stdio
# Local HTTP only. A container listens on every interface instead.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Responses flag data older than this many days as stale.
# STALE_AFTER_DAYS=30
# A file for the usage log, which always goes to stderr too.
# MCP_USAGE_LOG=
# Full tool-call traces, on through the hackathon. compose.yaml turns them on at
# /logs/traces unless this is set, and set empty here to turn them off.
# MCP_TRACE_DIR=
# MCP_TRACE_MAX_MB=400

# ─── Evaluation only (eval/README.md). The server does not read these ─────────
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
